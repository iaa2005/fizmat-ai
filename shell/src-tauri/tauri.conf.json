{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fizmat",
  "version": "0.3.0",
  "identifier": "ai.fizmat.guard",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../dist-guard/guard/": "guard/"
    },
    "publisher": "Fizmat",
    "shortDescription": "Fizmat с защитой личных данных",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
