  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNDk0RUI0QkU0MjZGNTkKUldSWmIwSyt0RTVKejkxdjlNWVNsY0Y4QldHOERBeTRwM3lobVgyT0tUQ2xuSzB4STUvS09EQy8K",
